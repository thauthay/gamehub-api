# Copie para .env (cp .env.example .env). Valores abaixo servem APENAS para desenvolvimento local.
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gamehub

# Origens permitidas no WebSocket (separadas por vírgula). Vazio = nenhuma origem de navegador.
# CORS_ORIGINS=http://localhost:5173

# Em produção com várias instâncias, use false e rode `npm run migration:up` no deploy.
RUN_MIGRATIONS=true
